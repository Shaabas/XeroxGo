# /etc/default/xeroxgo-kiosk
# Configuration file for XeroxGo Kiosk Spooler & Display Daemon

# Cloud backend WebSocket endpoint (use wss:// for production HTTPS/WSS)
XEROXGO_CLOUD_WS_URL=wss://xeroxgo-cloud.onrender.com/ws

# Unique identifier for this physical kiosk unit
XEROXGO_KIOSK_ID=kiosk-demo

# CUPS printer queue name (e.g. DCPT310)
XEROXGO_CUPS_PRINTER=DCPT310

# URL rendered on the idle QR code
XEROXGO_IDLE_QR_CONTENT=https://xeroxgo.vercel.app

# Brother HL-L5210DN printer TCP address (PJL RAW port 9100)
# Default is direct-attach static IP 192.168.99.2:9100
XEROXGO_PRINTER_ADDR=192.168.99.2:9100
