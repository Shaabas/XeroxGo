# XeroxGo Kiosk Spooler & HDMI Display Daemon systemd Unit
#
# Configured for Raspberry Pi OS framebuffer (/dev/fb0) with full
# terminal cursor suppression and display isolation.

[Unit]
Description=XeroxGo Kiosk Spooler & HDMI Display Daemon
Documentation=https://github.com/xeroxgo/xeroxgo
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=notify
WatchdogSec=10
Restart=always
RestartSec=5

User=xg1
Group=xg1
SupplementaryGroups=video lp input

# Terminal isolation: suppress cursor and screen blanking on HDMI
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=null
StandardOutput=journal
StandardError=journal
ExecStartPre=/usr/bin/setterm --cursor off --blank 0 --powerdown 0

EnvironmentFile=-/etc/default/xeroxgo-kiosk

ExecStart=/home/xg1/xeroxgo-kiosk \
  --cloud-url=${XEROXGO_CLOUD_WS_URL:-wss://xeroxgo-cloud.onrender.com/ws} \
  --kiosk-id=${XEROXGO_KIOSK_ID:-kiosk-demo} \
  --cups-printer=${XEROXGO_CUPS_PRINTER:-DCPT310} \
  --state-db=/var/kiosk/state.db \
  --download-dir=/var/kiosk/jobs \
  --framebuffer=/dev/fb0 \
  --idle-qr-content=${XEROXGO_IDLE_QR_CONTENT:-https://xeroxgo.vercel.app}

# Security hardening and device access
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/kiosk /dev/fb0 /dev/tty1
DeviceAllow=/dev/fb0 rw
DeviceAllow=/dev/tty1 rw

[Install]
WantedBy=multi-user.target
