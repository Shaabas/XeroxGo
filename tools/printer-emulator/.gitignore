# Ignore runtime PID and log files
emulator.pid
emulator.log
cups_queue.meta
.emulator_startup.lock
.xeroxgo_emulator_manifest
.xeroxgo_emulator_spool

# Ignore SNMP emulator binaries and runtime state
snmp_responder
snmp_responder.pid
snmp_responder.log
snmp_state.json
.snmp_startup.lock

# Ignore job artifacts generated in spool directory
spool/*
!spool/.gitkeep

# Track test sample PDF
!testdata/*.pdf


