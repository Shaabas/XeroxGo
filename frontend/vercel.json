{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://xeroxgo-cloud.onrender.com/api/:match*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin.html"
    },
    {
      "source": "/k/:kiosk_id",
      "destination": "/"
    },
    {
      "source": "/k/:kiosk_id/",
      "destination": "/"
    },
    {
      "source": "/healthz",
      "destination": "https://xeroxgo-cloud.onrender.com/healthz"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
